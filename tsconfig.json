{
  "compilerOptions": {
    "strict": true,
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "stripInternal": true,
    "types": ["vitest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tsdown.config.ts"]
}
